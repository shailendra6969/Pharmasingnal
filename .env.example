# PharmaSignal environment configuration (spec §53)
# Copy to .env and fill in. NEVER commit .env.

# --- Database ---
DATABASE_URL=postgresql://localhost:5432/pharmasignal
TEST_DATABASE_URL=postgresql://localhost:5432/pharmasignal_test

# --- LLM / embeddings (Phase 4+) ---
LLM_API_KEY=
LLM_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536

# --- Data paths ---
FAERS_DATA_PATH=data/raw/FAERS
FDA_DATA_PATH=data/raw/FDA
PROCESSED_DATA_PATH=data/processed

# --- FAERS scope (spec §6): ~8 quarters, full background ---
FAERS_QUARTERS=2024q1,2024q2,2024q3,2024q4,2025q1,2025q2,2025q3,2025q4
# Deep-analysis focus drugs (analysis filter ONLY — never the statistical background, spec §5)
FOCUS_DRUGS=METFORMIN,IBUPROFEN,SERTRALINE,ATORVASTATIN,OMEPRAZOLE

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Admin API ---
# Shared secret for /api/admin/* routes (e.g. POST /api/admin/refresh for the
# quarterly refresh). Leave EMPTY to disable those routes (they return 503).
# Send as `Authorization: Bearer <key>` or `X-Admin-Key: <key>`.
ADMIN_API_KEY=
